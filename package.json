{
  "name": "dsh-discussion-workbench",
  "version": "0.1.0",
  "description": "DSH 讨论工作台：统一会议与项目材料、固定整理目标、动态模型上下文和文档变更反馈。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["lib", "src", "skills", "docs", "cordis.patch.yml", "README.md", "AGENTS.md"],
  "engines": { "node": ">=20" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": [] }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsdown -c tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "dependencies": { "ws": "^8.18.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-skill": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/ws": "^8.5.10",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
