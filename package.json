{
  "name": "dsh-discussion-workbench",
  "version": "0.2.1-rc.2+rev.1",
  "description": "管理参考材料、固定目标文档，联动结构化文档、视图和侧边栏工具，支持 Agent 在讨论中整理与修改文档。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "locale"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:client": "tsdown -c tsdown.config.ts",
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:client && vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/ws": "8.18.2",
    "react": "18.3.1",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/irvingzhang0512/dsh-discussion-workbench.git"
  }
}
